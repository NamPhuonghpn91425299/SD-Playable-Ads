            u_xlat16_2.xyz;\n    u_xlat16_1.x = u_xlat0.y * u_xlat0.y;\n    u_xlat16_1.x
            = u_xlat0.x * u_xlat0.x + (-u_xlat16_1.x);\n    u_xlat16_2 = u_xlat0.yzzx
            * u_xlat0.xyzz;\n    u_xlat16_3.x = dot(unity_SHBr, u_xlat16_2);\n   
