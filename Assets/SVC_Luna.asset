            = u_xlat16_0.xyz * _LightColor0.xyz;\n    u_xlat0.xyz = u_xlat16_4.xyz
            * u_xlat16_1.xxx + (-unity_FogColor.xyz);\n    u_xlat9 = vs_TEXCOORD6;\n   
