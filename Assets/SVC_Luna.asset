            u_xlat2.xyz);\n    u_xlat0.x = clamp(u_xlat0.x, 0.0, 1.0);\n    u_xlat5.x
            = u_xlat15 * u_xlat15;\n    u_xlat1.x = u_xlat5.x * u_xlat5.x;\n    u_xlat1.y
            = (-_Glossiness) + 1.0;\n    u_xlat5.x = texture2D(unity_NHxRoughness,
