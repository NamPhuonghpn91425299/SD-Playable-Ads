            u_xlat16_5;\nfloat u_xlat12;\nmediump float u_xlat16_13;\nvoid main()\n{\n   
            u_xlat16_0.xy = texture(_BumpMap, vs_TEXCOORD0.xy).yw;\n    u_xlat16_1.xy
            = u_xlat16_0.yx * vec2(2.0, 2.0) + vec2(-1.0, -1.0);\n    u_xlat16_13
            = dot(u_xlat16_1.xy, u_xlat16_1.xy);\n    u_xlat16_13 = min(u_xlat16_13,
            1.0);\n    u_xlat16_13 = (-u_xlat16_13) + 1.0;\n    u_xlat16_1.z = sqrt(u_xlat16_13);\n   
            u_xlat16_2.x = dot(vs_TEXCOORD1.xyz, u_xlat16_1.xyz);\n    u_xlat16_2.y
