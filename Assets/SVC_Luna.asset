            u_xlat16_8.xyz = u_xlat16_1.xyz * vec3(u_xlat16_30);\n    u_xlat16_8.xyz
            = u_xlat10_0.xxx * u_xlat16_8.xyz;\n    u_xlat16_3.xyz = u_xlat16_8.xyz
