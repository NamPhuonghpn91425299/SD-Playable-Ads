            * u_xlat16_12.xzw + u_xlat0.xyz;\n    u_xlat16_3.xyz = u_xlat16_11.xyz
            * vec3(u_xlat42);\n    u_xlat16_11.xyz = (-u_xlat16_2.xyz) + vec3(u_xlat16_44);\n   
            u_xlat16_2.xyz = vec3(u_xlat16_26) * u_xlat16_11.xyz + u_xlat16_2.xyz;\n   
            u_xlat0.xyz = u_xlat16_3.xyz * u_xlat16_2.xyz + u_xlat0.xyz;\n    u_xlat16_1.xyz
            = texture(_EmissionMap, vs_TEXCOORD0.xy).xyz;\n    u_xlat16_2.xyz = u_xlat16_1.xyz
            * _EmissionColor.xyz + u_xlat0.xyz;\n    u_xlat0.x = vs_TEXCOORD1.w;\n   
            u_xlat0.x = clamp(u_xlat0.x, 0.0, 1.0);\n    u_xlat14.xyz = u_xlat16_2.xyz
            + (-unity_FogColor.xyz);\n    u_xlat0.xyz = u_xlat0.xxx * u_xlat14.xyz
            + unity_FogColor.xyz;\n    SV_Target0.xyz = u_xlat0.xyz;\n    SV_Target0.w
            = 1.0;\n    return;\n}\n\n"
