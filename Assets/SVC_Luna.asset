            = u_xlat0.y;\n    vs_TEXCOORD3.w = u_xlat0.z;\n    vs_TEXCOORD2.x = u_xlat1.x;\n   
            vs_TEXCOORD3.x = u_xlat1.y;\n    vs_TEXCOORD2.y = u_xlat3.y;\n    vs_TEXCOORD3.y
            = u_xlat3.z;\n    vs_TEXCOORD2.z = u_xlat2.y;\n    vs_TEXCOORD3.z = u_xlat2.z;\n   
