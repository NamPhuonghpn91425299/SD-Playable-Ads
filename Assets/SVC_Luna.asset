            * u_xlat16_1.xxx + u_xlat16_4.xyz;\n    u_xlat0.xyz = u_xlat16_1.xyz
            + (-unity_FogColor.xyz);\n    u_xlat9 = vs_TEXCOORD6;\n    u_xlat9 =
