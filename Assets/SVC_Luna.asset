            * in_POSITION0.www + u_xlat0.xyz;\n    vs_TEXCOORD1.xyz = u_xlat0.xyz
            + (-_WorldSpaceCameraPos.xyz);\n    u_xlat1.xyz = (-u_xlat0.xyz) * _WorldSpaceLightPos0.www
