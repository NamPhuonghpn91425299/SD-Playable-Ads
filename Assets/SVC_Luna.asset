            * vs_TEXCOORD4.xxxx + u_xlat0;\n    u_xlat0 = hlslcc_mtx4x4unity_WorldToLight[2]
            * vs_TEXCOORD4.zzzz + u_xlat0;\n    u_xlat0 = u_xlat0 + hlslcc_mtx4x4unity_WorldToLight[3];\n   
            u_xlat3.xy = u_xlat0.xy / u_xlat0.ww;\n    u_xlat3.xy = u_xlat3.xy +
            vec2(0.5, 0.5);\n    u_xlat12 = texture2D(_LightTexture0, u_xlat3.xy).w;\n   
            u_xlatb3 = 0.0<u_xlat0.z;\n    u_xlat0.x = dot(u_xlat0.xyz, u_xlat0.xyz);\n   
