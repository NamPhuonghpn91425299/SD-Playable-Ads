            + (-vs_TEXCOORD1.xyz);\n    u_xlat18 = dot(u_xlat2.xyz, _WorldSpaceLightPos0.xyz);\n   
            u_xlat18 = clamp(u_xlat18, 0.0, 1.0);\n    u_xlat16_5.xyz = vec3(u_xlat18)
            * _LightColor0.xyz;\n    u_xlat18 = dot(u_xlat4.xyz, _WorldSpaceLightPos0.xyz);\n   
