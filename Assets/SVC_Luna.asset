            u_xlat3.xyz = vec3(u_xlat12) * u_xlat3.xyz;\n    u_xlat16_1.x = dot(u_xlat0.xyz,
            u_xlat3.xyz);\n    u_xlat16_1.x = max(u_xlat16_1.x, 0.0);\n    u_xlat0
            = vs_TEXCOORD4.yyyy * hlslcc_mtx4x4unity_WorldToLight[1];\n    u_xlat0
            = hlslcc_mtx4x4unity_WorldToLight[0] * vs_TEXCOORD4.xxxx + u_xlat0;\n   
            u_xlat0 = hlslcc_mtx4x4unity_WorldToLight[2] * vs_TEXCOORD4.zzzz + u_xlat0;\n   
            u_xlat0 = u_xlat0 + hlslcc_mtx4x4unity_WorldToLight[3];\n    u_xlat3.xy
            = u_xlat0.xy / u_xlat0.ww;\n    u_xlat3.xy = u_xlat3.xy + vec2(0.5, 0.5);\n   
