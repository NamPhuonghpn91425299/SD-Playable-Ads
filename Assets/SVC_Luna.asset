            vs_TEXCOORD3.y = u_xlat3.z;\n    vs_TEXCOORD2.z = u_xlat4.y;\n    vs_TEXCOORD3.w
            = u_xlat0.z;\n    vs_TEXCOORD3.z = u_xlat4.z;\n    u_xlat16_5.x = u_xlat4.y
            * u_xlat4.y;\n    u_xlat16_5.x = u_xlat4.x * u_xlat4.x + (-u_xlat16_5.x);\n   
