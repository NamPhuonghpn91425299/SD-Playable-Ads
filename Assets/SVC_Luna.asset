            + u_xlat16_6.xyz;\n    u_xlat16_5.xyz = max(u_xlat16_5.xyz, vec3(0.0,
            0.0, 0.0));\n    u_xlat3.xyz = log2(u_xlat16_5.xyz);\n    u_xlat3.xyz
