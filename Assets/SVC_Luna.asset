            _MainTex;\nvarying mediump vec4 vs_COLOR0;\nvarying highp vec2 vs_TEXCOORD0;\nvarying
            mediump float vs_TEXCOORD1;\n#define SV_Target0 gl_FragData[0]\nlowp
            vec4 u_xlat10_0;\nmediump vec3 u_xlat16_1;\nmediump float u_xlat16_7;\nvoid
            main()\n{\n    u_xlat10_0 = texture2D(_MainTex, vs_TEXCOORD0.xy);\n   
            u_xlat16_1.xyz = u_xlat10_0.xyz * vs_COLOR0.xyz + (-unity_FogColor.xyz);\n   
            u_xlat16_7 = u_xlat10_0.w * vs_COLOR0.w;\n    SV_Target0.w = u_xlat16_7;\n   
            SV_Target0.xyz = vec3(vs_TEXCOORD1) * u_xlat16_1.xyz + unity_FogColor.xyz;\n   
            return;\n}\n\n"
