            = u_xlat16_6.xyz * u_xlat16_5.xyz + u_xlat16_3.xyz;\n    u_xlat16_0.xyz
            = texture(_EmissionMap, vs_TEXCOORD0.xy).xyz;\n    u_xlat16_3.xyz = u_xlat16_0.xyz
            * _EmissionColor.xyz + u_xlat16_3.xyz;\n    u_xlat0.xyz = u_xlat16_3.xyz
            + (-unity_FogColor.xyz);\n    u_xlat24 = vs_TEXCOORD1.w;\n    u_xlat24
