            u_xlat0.xyz);\n    u_xlat16_11 = max(u_xlat16_11, 0.0);\n    SV_Target0.xyz
            = vec3(u_xlat16_11) * u_xlat16_2.xyz;\n    SV_Target0.w = 1.0;\n    return;\n}\n\n"
