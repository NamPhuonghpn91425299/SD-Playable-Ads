            = log2(u_xlat16_0.xyz);\n    u_xlat3.xyz = u_xlat3.xyz * vec3(0.416666657,
            0.416666657, 0.416666657);\n    u_xlat3.xyz = exp2(u_xlat3.xyz);\n   
