            u_xlat0;\nmediump vec4 u_xlat16_0;\nmediump vec3 u_xlat16_1;\nmediump
            vec3 u_xlat16_2;\nmediump vec3 u_xlat16_4;\nmediump float u_xlat16_10;\nvoid
            main()\n{\n    u_xlat16_0.xy = texture(_BumpMap, vs_TEXCOORD0.xy).yw;\n   
