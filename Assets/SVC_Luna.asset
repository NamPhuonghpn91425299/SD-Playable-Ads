            * u_xlat2.zxy;\n    u_xlat3.xyz = u_xlat2.yzx * u_xlat1.yzx + (-u_xlat3.xyz);\n   
            u_xlat3.xyz = u_xlat0.xxx * u_xlat3.xyz;\n    vs_TEXCOORD1.y = u_xlat3.x;\n   
