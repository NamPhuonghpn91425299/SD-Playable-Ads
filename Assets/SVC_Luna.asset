            lowp sampler2D _BumpMap;\nuniform mediump sampler2D unity_Lightmap;\nvarying
            highp vec2 vs_TEXCOORD0;\nvarying highp float vs_TEXCOORD4;\nvarying
            highp float vs_TEXCOORD6;\nvarying highp vec4 vs_TEXCOORD1;\nvarying
