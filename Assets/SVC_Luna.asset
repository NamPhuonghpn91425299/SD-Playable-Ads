            vec4 _LightColor0;\nuniform lowp sampler2D _MainTex;\nuniform lowp sampler2D
            _BumpMap;\nvarying highp vec2 vs_TEXCOORD0;\nvarying highp float vs_TEXCOORD4;\nvarying
