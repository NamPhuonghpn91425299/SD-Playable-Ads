            u_xlat16_3.xyz = u_xlat10_1.xyz * u_xlat16_3.xxx;\n    u_xlat10_0.x =
            texture2D(_OcclusionMap, vs_TEXCOORD0.xy).y;\n    u_xlat16_3.xyz = u_xlat10_0.xxx
            * u_xlat16_3.xyz;\n    u_xlat18 = dot((-vs_TEXCOORD1.xyz), u_xlat2.xyz);\n   
