            sampler2D _MainTex;\nuniform lowp sampler2D _BumpMap;\nvarying highp
            vec2 vs_TEXCOORD0;\nvarying highp float vs_TEXCOORD4;\nvarying highp
            float vs_TEXCOORD6;\nvarying highp vec4 vs_TEXCOORD1;\nvarying highp
            vec4 vs_TEXCOORD2;\nvarying highp vec4 vs_TEXCOORD3;\n#define SV_Target0
            gl_FragData[0]\nvec4 u_xlat0;\nlowp vec3 u_xlat10_0;\nmediump vec3 u_xlat16_1;\nmediump
            vec3 u_xlat16_2;\nmediump vec3 u_xlat16_4;\nfloat u_xlat9;\nmediump float
            u_xlat16_10;\nvoid main()\n{\n    u_xlat10_0.xy = texture2D(_BumpMap,
            vs_TEXCOORD0.xy).yw;\n    u_xlat16_1.xy = u_xlat10_0.yx * vec2(2.0, 2.0)
