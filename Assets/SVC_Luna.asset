            vec3 u_xlat16_8;\nfloat u_xlat9;\nmediump vec3 u_xlat16_10;\nfloat u_xlat18;\nfloat
            u_xlat29;\nmediump float u_xlat16_30;\nmediump float u_xlat16_32;\nvoid
            main()\n{\n    u_xlat0.xw = (-vec2(_Glossiness)) + vec2(1.0, 1.0);\n   
